diff --git a/src/gbi/rt64_gbi_l3dex2.cpp b/src/gbi/rt64_gbi_l3dex2.cpp
index 3c30e2a..4c57dd7 100644
--- a/src/gbi/rt64_gbi_l3dex2.cpp
+++ b/src/gbi/rt64_gbi_l3dex2.cpp
@@ -4,9 +4,30 @@
 
 #include "rt64_gbi_l3dex2.h"
 
+#include "hle/rt64_interpreter.h"
+
+#include "rt64_gbi_f3dex.h"
 #include "rt64_gbi_f3dex2.h"
 
 namespace RT64 {
+    namespace GBI_L3DEX {
+        void line3D(State *state, DisplayList **dl) {
+            // gSPLineW3D: the two ends' indices, doubled, and the width, in the second word, where L3DEX2's has them in
+            // the first. Drawn as RT64_DRAW_LINES draws L3DEX2's; without it, nothing. Either way the rest of the list is
+            // read as the microcode reads it: as an unknown microcode only the RDP's commands were, so a list switching
+            // to it never found its end and the interpreter ran on through RDRAM until it faulted.
+#       if RT64_DRAW_LINES
+            state->rsp->drawLine((*dl)->p1(17, 7), (*dl)->p1(9, 7), (*dl)->p1(0, 8));
+#       endif
+        }
+
+        void setup(GBI *gbi) {
+            GBI_F3DEX::setup(gbi);
+
+            gbi->map[L3DEX_G_LINE3D] = &line3D;
+        }
+    }
+
     namespace GBI_L3DEX2 {
         void line3D(State *state, DisplayList **dl) {
 #       if RT64_DRAW_LINES
@@ -22,4 +43,4 @@ namespace RT64 {

diff --git a/src/gbi/rt64_gbi_l3dex2.cpp b/src/gbi/rt64_gbi_l3dex2.cpp
--- a/src/gbi/rt64_gbi_l3dex2.cpp
+++ b/src/gbi/rt64_gbi_l3dex2.cpp
@@ -4,9 +4,24 @@
 
 #include "rt64_gbi_l3dex2.h"
 
+#include "rt64_gbi_f3dex.h"
 #include "rt64_gbi_f3dex2.h"
 
 namespace RT64 {
+    namespace GBI_L3DEX {
+        void line3D(State *state, DisplayList **dl) {
+            // Lines aren't drawn yet, as with L3DEX2. What matters is that the rest of the list is read as the
+            // microcode reads it: as an unknown microcode only the RDP's commands were, so a list switching to it
+            // never found its end and the interpreter ran on through RDRAM until it faulted.
+        }
+
+        void setup(GBI *gbi) {
+            GBI_F3DEX::setup(gbi);
+
+            gbi->map[L3DEX_G_LINE3D] = &line3D;
+        }
+    }
+
     namespace GBI_L3DEX2 {
         void line3D(State *state, DisplayList **dl) {
             assert(false);

+    void RSP::drawIndexedLine(uint32_t a, uint32_t b, uint8_t width) {
+        if ((a >= RSP_MAX_VERTICES) || (b >= RSP_MAX_VERTICES)) {
+            assert(false && "Vertex index is not valid. DL is possibly corrupted.");
+            return;
+        }
+
+        // The line microcodes draw a line as a quad along it on the screen, 1.5 pixels wide and half a pixel wider for
+        // each step of its width. Vertices are transformed on the GPU, so each corner is a copy of one end that
+        // RSPModifyCS moves off the line by half the width after the transform (the two low bits being 2), to the side
+        // that bit 8 of the value says, with the other end's index above it. It's done here too, for draw area
+        // tracking and the debugger. A line is drawn whichever way it faces.
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        const uint32_t ends[2] = { indices[a], indices[b] };
+        used[a] = used[b] = true;
+
+        const float halfWidth = (1.5f + width * 0.5f) / 2.0f;
+        uint32_t corners[4];
+        for (uint32_t i = 0; i < 4; i++) {
+            const uint32_t end = ends[i / 2];
+            const uint32_t other = ends[1 - (i / 2)];
+            const uint32_t side = i & 1;
+            assert((other < (1U << 23)) && "Too many vertices for a line's corner to name the other end.");
+            corners[i] = copyVertex(end);
+            workload.drawData.modifyPosUints.emplace_back((corners[i] << 2) | 0x2);
+            workload.drawData.modifyPosUints.emplace_back((other << 9) | (side << 8) | width);
+
+            auto &posScreen = workload.drawData.posScreen;
+            float dx = posScreen[other][0] - posScreen[end][0];
+            float dy = posScreen[other][1] - posScreen[end][1];
+            const float length = std::sqrt(dx * dx + dy * dy);
+            if (length > 0.0f) {
+                dx /= length;
+                dy /= length;
+            }
+            else {
+                dx = 1.0f;
+                dy = 0.0f;
+            }
+
+            const float offset = side ? -halfWidth : halfWidth;
+            posScreen[corners[i]][0] = posScreen[end][0] - dy * offset;
+            posScreen[corners[i]][1] = posScreen[end][1] + dx * offset;
+        }
+
+        // Each end's corners are on either side of the line, and the other end's are the other way round from it, so
+        // the four go round the quad.
+        const uint32_t cullMode = geometryModeStack[geometryModeStackSize - 1] & cullBothMask;
+        if (cullMode != 0) {
+            clearGeometryMode(cullMode);
+        }
+
+        drawIndexedTri(corners[0], corners[1], corners[2], true);
+        drawIndexedTri(corners[0], corners[2], corners[3], true);
+
+        if (cullMode != 0) {
+            setGeometryMode(cullMode);
+        }
+    }

+    void RDP::setAutoAnchor(uint8_t mode, int32_t ulx, int32_t uly, int32_t lrx, int32_t lry) {
+        extended.autoAnchor = mode;
+        extended.autoAnchorView[0] = ulx;
+        extended.autoAnchorView[1] = uly;
+        extended.autoAnchorView[2] = lrx;
+        extended.autoAnchorView[3] = lry;
+    }
+
+    // Anchors a HUD rectangle to the nearest screen edge when automatic
+    // anchoring is on and the rectangle has no alignment of its own: one
+    // half the screen wide or more stretches across the window, and smaller
+    // rectangles in the top quarter go to the side they're on, the bottom
+    // quarter's to the left (or right, past 60% of the width), and anything
+    // in between (crosshair, messages, menus) stays centred. Right-anchored
+    // coordinates are relative to the right edge. In a view of a split
+    // screen (mode 2), all of that is by where the rectangle sits in the
+    // view, a side is the view's edge, and what stays centred is centred in
+    // the view (the crosshair). The sides follow HUD Placement, as a single
+    // view's HUD does; RT64 widens a split screen's views to the window's
+    // edges, so a view's centre is where it is on the N64's screen as a
+    // fraction of the whole window.
+    ExtendedAlignment RDP::autoAnchorAlignment(int32_t ulx, int32_t uly, int32_t lrx, int32_t lry, const ExtendedAlignment &extAlignment) const {
+        if ((extended.autoAnchor == 0) || (extAlignment.leftOrigin != G_EX_ORIGIN_NONE) || (extAlignment.rightOrigin != G_EX_ORIGIN_NONE) || (colorImage.width == 0)) {
+            return extAlignment;
+        }
+
+        const int32_t width = int32_t(colorImage.width) * 4;
+        int32_t vx0 = 0, vy0 = 0, vx1 = width, vy1 = (width * 3) / 4;
+        if ((extended.autoAnchor == 2) && (extended.autoAnchorView[2] > extended.autoAnchorView[0]) && (extended.autoAnchorView[3] > extended.autoAnchorView[1])) {
+            vx0 = extended.autoAnchorView[0];
+            vy0 = extended.autoAnchorView[1];
+            vx1 = extended.autoAnchorView[2];
+            vy1 = extended.autoAnchorView[3];
+        }
+
+        // The origin at x on the screen, and what makes a coordinate relative
+        // to it.
+        const bool inView = (extended.autoAnchor == 2);
+        auto edgeOrigin = [width](int32_t x) -> uint16_t {
+            return uint16_t(std::clamp((x * G_EX_ORIGIN_RIGHT + width / 2) / width, 0, int32_t(G_EX_ORIGIN_RIGHT)));
+        };
+        auto originOffset = [width](uint16_t origin) -> int32_t {
+            return -((int32_t(origin) * width) / G_EX_ORIGIN_RIGHT);
+        };
+
+        const int32_t vw = vx1 - vx0;
+        const int32_t height = vy1 - vy0;
+        ExtendedAlignment result = extAlignment;
+        // As wide as the screen (a tint over the whole view, a menu's
+        // dimming, a cutscene's black bars): left as it is, so RT64
+        // stretches it across the whole window as it does any rectangle
+        // that covers the screen, and not only as far as the HUD may
+        // widen, which stops short of a window wider than that.
+        // So is one as wide as its view, which RT64 widens with the view.
+        if ((ulx <= vx0) && (lrx + 4 >= vx1)) {
+            return extAlignment;
+        }
+
+        // Half the screen (or view) wide or more: stretched across the HUD
+        // instead, its sides as far from its edges as from the view's.
+        if ((lrx - ulx) * 2 >= vw) {
+            result.leftOrigin = edgeOrigin(vx0);
+            result.rightOrigin = edgeOrigin(vx1);
+            result.leftOffset += originOffset(result.leftOrigin);
+            result.rightOffset += originOffset(result.rightOrigin);
+            return result;
+        }
+
+        const int32_t cx = (ulx + lrx) / 2 - vx0;
+        const int32_t cy = (uly + lry) / 2 - vy0;
+        int side = 0; // -1 the view's left edge, 1 its right
+        if (cy < height / 4) {
+            side = (cx < vw / 2) ? -1 : 1;
+        }
+        // Just below the top quarter (to a third), only well to a side: the
+        // second line of counters goes with the first, while
+        // what's near the middle stays centred.
+        else if ((cy < height / 3) && ((cx < (vw * 3) / 10) || (cx > (vw * 7) / 10))) {
+            side = (cx < vw / 2) ? -1 : 1;
+        }
+        else if (cy > (height * 3) / 4) {
+            side = (cx < (vw * 3) / 5) ? -1 : 1;
+        }
+
+        if ((side != 0) || inView) {
+            const uint16_t origin = edgeOrigin((side < 0) ? vx0 : (side > 0) ? vx1 : (vx0 + vx1) / 2);
+            result.leftOrigin = origin;
+            result.rightOrigin = origin;
+            result.leftOffset += originOffset(origin);
+            result.rightOffset += originOffset(origin);
+            result.windowOrigins = (side == 0);
+        }
+        return result;
+    }
